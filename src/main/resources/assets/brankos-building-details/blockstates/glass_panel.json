{
  "multipart": [
    {
      "when": { "north": "true" },
      "apply": { "model": "brankos-building-details:block/glass_panel_north" }
    },
    {
      "when": { "east": "true" },
      "apply": { "model": "brankos-building-details:block/glass_panel_north", "y": 90 }
    },
    {
      "when": { "south": "true" },
      "apply": { "model": "brankos-building-details:block/glass_panel_north", "y": 180 }
    },
    {
      "when": { "west": "true" },
      "apply": { "model": "brankos-building-details:block/glass_panel_north", "y": 270 }
    }
  ]
}
