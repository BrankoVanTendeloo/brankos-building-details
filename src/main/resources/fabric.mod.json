{
	"schemaVersion": 1,
	"id": "brankos-building-details",
	"version": "1.0.0",
	"name": "Branko's Building Details",
	"description": "A Fabric mod for adding decorative building details to Minecraft.",
	"authors": [
		"Branko"
	],
	"license": "CC0-1.0",
	"icon": "assets/brankos-building-details/icon.png",
	"environment": "*",
	"mixins": [
		"brankos-building-details.mixins.json",
		"brankos-building-details.client.mixins.json"
	],
	"entrypoints": {
		"main": [
			"branko.brankosbuildingdetails.BrankosBuildingDetails"
		],
		"client": [
			"branko.brankosbuildingdetails.client.BrankosBuildingDetailsClient"
		],
		"fabric-datagen": [
			"branko.brankosbuildingdetails.client.BrankosBuildingDetailsDataGenerator"
		]
	},
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}